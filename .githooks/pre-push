#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
manifest=core/Cargo.toml

step() { printf '\n==> %s\n' "$1"; }

step "Fixture metadata"
python3 core/eval/verify-fixtures.py

step "Evaluation rebuilds"
python3 -m unittest discover -s core/eval -p 'test_*.py' </dev/null

step "Engine and playground tests"
cargo test --manifest-path "$manifest" --all --locked </dev/null

if node -e "require.resolve('playwright')" >/dev/null 2>&1; then
  step "Browser smoke"
  cargo build --manifest-path "$manifest" --locked
  node playground/smoke.cjs </dev/null
else
  step "Browser smoke skipped: set NODE_PATH to a node_modules containing playwright to run it"
fi
