#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
manifest=core/Cargo.toml

step() { printf '\n==> %s\n' "$1"; }

step "Formatting"
cargo fmt --manifest-path "$manifest" --all --check

step "Lint"
cargo clippy --manifest-path "$manifest" --all-targets --locked -- -D warnings
